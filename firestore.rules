rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test connection doc
    match /test/connection {
      allow read, write: if true;
    }

    // Beneficiaries collection
    match /beneficiaries/{beneficiaryId} {
      allow read, write: if true;
    }

    // Attendance Sessions collection
    match /attendanceSessions/{sessionId} {
      allow read, write: if true;
    }

    // Airtime Records collection
    match /airtimeRecords/{recordId} {
      allow read, write: if true;
    }

    // Bulk Message Logs collection
    match /bulkMessageLogs/{logId} {
      allow read, write: if true;
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Catch-all safety fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
